APP_NAME="Instacertify ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://instacertify.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=instacertify
DB_USERNAME=instacertify
DB_PASSWORD=change-me-db-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@instacertify.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=instacertify
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=instacertify
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

MINIO_ROOT_USER=instacertify
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

HTTP_PORT=80
HTTPS_PORT=443

HORIZON_PREFIX=instacertify_horizon

ERP_NAME="Instacertify ERP"
ERP_COMPANY=Instacertify
ERP_DOMAIN=instacertify.in

ERP_MODULE_CRM=true
ERP_MODULE_SALES=true
ERP_MODULE_PROJECTS=true
ERP_MODULE_CALENDAR=true
ERP_MODULE_CHAT=true
ERP_MODULE_STORAGE=true
ERP_MODULE_TESTING=true
ERP_MODULE_SAMPLES=true
ERP_MODULE_HRMS=true
ERP_MODULE_BILLING=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GLITCHTIP_PORT=8001
GLITCHTIP_SECRET_KEY=change-me-glitchtip-secret

VITE_APP_NAME="${APP_NAME}"
